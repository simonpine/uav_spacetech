<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vtol_control</name>
  <version>0.1.0</version>
  <description>
    Controlador de vuelo estabilizado y piloto de teclado para el VTOL tiltrotor
    de tres motores tipo SNOOP. Aporta los lazos de actitud, el mezclador de
    actuadores y la secuencia de transición que vtol_tiltrotor_description deja
    fuera a propósito.
  </description>
  <maintainer email="ceres.roverteam@gmail.com">ceres</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>actuator_msgs</exec_depend>
  <exec_depend>vtol_tiltrotor_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
