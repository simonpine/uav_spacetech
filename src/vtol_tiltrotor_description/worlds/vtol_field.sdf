<?xml version="1.0"?>
<!--
  vtol_field.sdf - flight-test world for the tri-motor tiltrotor.

  Deliberately sparse: a ground plane, a sun, a painted runway centreline and a
  few markers.  The markers are the only way you can tell you are moving at
  20 m/s over an infinite grey plane, and the runway gives you a heading
  reference for the transition.  Everything is a primitive so it stays cheap on
  a Jetson.
-->
<sdf version="1.9">
  <world name="vtol_field">

    <!-- GUI layout. The camera does not follow the aircraft automatically;
         right-click it and pick "Follow" for a chase view. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.45 0.47 0.50</ambient_light>
        <background_color>0.55 0.68 0.85</background_color>
        <camera_pose>-9 0 4 0 0.28 0</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </ignition-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </ignition-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
    </gui>

    <physics name="2ms" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-navsat-system"
        name="ignition::gazebo::systems::NavSat"/>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>4.7110</latitude_deg>
      <longitude_deg>-74.0721</longitude_deg>
      <elevation>2600</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.45 0.47 0.50 1</ambient>
      <background>0.55 0.68 0.85 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 120 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.25 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>4000 4000</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>4000 4000</size></plane></geometry>
          <material>
            <ambient>0.28 0.36 0.22 1</ambient>
            <diffuse>0.33 0.43 0.25 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Runway: 300 m of asphalt down +x, so "forward" is unambiguous. -->
    <model name="runway">
      <static>true</static>
      <pose>140 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="strip">
          <geometry><box><size>300 16 0.02</size></box></geometry>
          <material>
            <ambient>0.17 0.17 0.18 1</ambient>
            <diffuse>0.22 0.22 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Centreline dashes every 20 m: your speed cue. -->
    <model name="centreline">
      <static>true</static>
      <link name="link">
        <visual name="dash_0">
          <pose>-10 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_1">
          <pose>10 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_2">
          <pose>30 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_3">
          <pose>50 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_4">
          <pose>70 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_5">
          <pose>90 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_6">
          <pose>110 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_7">
          <pose>130 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_8">
          <pose>150 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_9">
          <pose>170 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_10">
          <pose>190 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_11">
          <pose>210 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_12">
          <pose>230 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_13">
          <pose>250 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="dash_14">
          <pose>270 0 0.03 0 0 0</pose>
          <geometry><box><size>8 0.9 0.02</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Height/scale markers: 12 m masts in a ring, spaced so you can judge
         altitude and bank angle without an instrument panel. -->
    <model name="markers">
      <static>true</static>
      <link name="link">
        <visual name="mast_0">
          <pose>90.00 0.00 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_0">
          <pose>90.00 0.00 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_1">
          <pose>72.81 52.90 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_1">
          <pose>72.81 52.90 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_2">
          <pose>27.81 85.60 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_2">
          <pose>27.81 85.60 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_3">
          <pose>-27.81 85.60 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_3">
          <pose>-27.81 85.60 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_4">
          <pose>-72.81 52.90 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_4">
          <pose>-72.81 52.90 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_5">
          <pose>-90.00 0.00 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_5">
          <pose>-90.00 0.00 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_6">
          <pose>-72.81 -52.90 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_6">
          <pose>-72.81 -52.90 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_7">
          <pose>-27.81 -85.60 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_7">
          <pose>-27.81 -85.60 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_8">
          <pose>27.81 -85.60 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_8">
          <pose>27.81 -85.60 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="mast_9">
          <pose>72.81 -52.90 6 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>12</length></cylinder></geometry>
          <material><ambient>0.85 0.32 0.05 1</ambient><diffuse>0.95 0.42 0.05 1</diffuse></material>
        </visual>
        <visual name="mast_top_9">
          <pose>72.81 -52.90 12.4 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Obstáculos para la prueba de la cámara de profundidad -->
    <model name="test_box">
      <static>true</static>
      <pose>6 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 2 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1 2 2</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="test_box_far">
      <static>true</static>
      <pose>14 -3 1.5 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2 2 3</size></box></geometry>
          <material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.3 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
